# Fill in actual private storage configuration. Never commit .env.
SERVICE_TOKEN=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
# Leave both credentials unset for the default boto3 IAM/role credential chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_ALLOWED_PREFIX=listings/
S3_LISTING_SCOPE=true
MAX_PHOTOS=20
MAX_IMAGE_BYTES=12582912
MAX_PIXELS=24000000
DOWNLOAD_WORKERS=2
BATCH_SIZE=4
CPU_THREADS=2
DEVICE=cpu
CV_BACKEND=trained
# v1 uses the separately supplied v19 model artifact.
TRAINED_MODEL_DIR=models/view-classifier-triple-v19-apache-balanced
MODEL_DIR=models/clip
DETECTOR_PATH=models/ssdlite.pt
CHECKLIST_PATH=configs/checklist-kafka.json
CALIBRATION_PATH=configs/calibration.json
# Local MinIO only: choose your own credentials; no default secrets.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Enable only after configuring the existing project's Kafka. No broker is created.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_INPUT_TOPIC=
KAFKA_RESULT_TOPIC=
KAFKA_DLQ_TOPIC=
KAFKA_GROUP_ID=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Optional CA file for SSL/SASL_SSL (omit when using system trust).
# KAFKA_SSL_CAFILE=/path/to/ca.pem
KAFKA_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF=1
STATE_PATH=data/advisor.sqlite3
KAFKA_CHECKLIST_PATH=configs/checklist-kafka.json
